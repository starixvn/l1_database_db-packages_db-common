{
  "name": "@ldb/db-common",
  "version": "1.1.5",
  "description": "Database common modules",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "repl": "env $(grep -v '^#' .env | xargs -d '\n') ts-node --transpileOnly --experimentalSpecifierResolution=node --interactive",
    "clean:rm": "rm -rf node_modules && rm package-lock.json || true",
    "clean": "npm run clean:rm && npm install",
    "build": "rm -rf lib && tsc -p src",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://git3.nexdev.net/l1/database/db-packages/db-common.git"
  },
  "author": {
    "name": "Billy Bùi",
    "email": "billy.bui@luminet.vn"
  },
  "license": "ISC",
  "dependencies": {
    "@ldb/logger": "1.0.1",
    "@ldb/terminal-paint": "1.0.0",
    "bson": "4.7.0",
    "mongodb": "4.11.0",
    "mongodb-connection-string-url": "2.5.4"
  },
  "devDependencies": {
    "@types/mongodb": "^4.0.7",
    "@types/node": "^18.11.2",
    "@typescript-eslint/eslint-plugin": "^5.40.1",
    "@typescript-eslint/parser": "^5.40.1",
    "eslint": "^8.25.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "typescript": "^4.8.4"
  }
}
